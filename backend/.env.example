# Copy to backend/.env and fill in. Never commit the real .env.

# --- Login (one generic user) ---
APP_USERNAME=admin
# Generate with: uv run python -m app.cli hash-password
# In .env files, escape each "$" in the hash as "$$" if your tool expands variables (docker compose does).
APP_PASSWORD_HASH=
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Security behind a proxy ---
# true only when running behind the Cloudflare tunnel (reads CF-Connecting-IP)
TRUST_PROXY=false
# true in production (HTTPS); false for local http://localhost
COOKIE_SECURE=false

# --- Paths (relative to backend/) ---
DB_PATH=data/app.sqlite
CONFIG_DIR=config
DATA_DIR=data

# --- AI explanation (provider to be decided) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
