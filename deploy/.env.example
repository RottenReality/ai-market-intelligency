# Copy to deploy/.env on the server (never commit it).

APP_USERNAME=admin
# From: docker compose -f deploy/docker-compose.yml run --rm api python -m app.cli hash-password
# Keep the single quotes: they stop "$" in the hash from being treated as a variable.
APP_PASSWORD_HASH='paste-the-bcrypt-hash-here'
# From: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- AI analysis (free, no card: key at https://console.groq.com/keys) ---
GROQ_API_KEY=
# Models offered in the AI selector, comma-separated, best first. Each has its own free limit.
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# Only for a named tunnel with your own domain (see docs/deploy.md)
TUNNEL_TOKEN=
